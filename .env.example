# Optional overrides for the shared Llama API used by selfchat, .gpt/.gemini,
# chatbot, and AI antibadword. Defaults use the public API endpoint and key
# supplied with this project; override these only in Railway variables.
# LLAMA_API_KEY=Suhail

# Optional overrides.
# LLAMA_API_URL=https://llama.gtech-apiz.workers.dev/
# LLAMA_TIMEOUT_MS=20000

# On Railway, set this to the mount path of the persistent session volume.
# Example: SESSION_DIR=/app/session (see RAILWAY_DEPLOYMENT.md).
# SESSION_DIR=
